{
  "name": "edutechlife-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs && node scripts/generate-sitemap.mjs",
    "build:fast": "vite build",
    "build:full": "vite build && node scripts/prerender.mjs && node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "qa:pdfs": "node scripts/qa/run-qa-pdfs.js",
    "sync:video-durations": "node src/components/IALab/constants/syncVideoDurations.mjs",
    "i18n:validate": "node scripts/validate-i18n.js",
    "i18n:sync-types": "python3 scripts/sync-i18n-types.py",
    "i18n:full": "npm run i18n:validate && npm run i18n:sync-types",
    "i18n:extract": "node scripts/extract-hardcoded.js",
    "test:smoke": "vitest run src/store/__tests__/ src/components/IALab/__tests__/ src/components/IALab/IALabValerioPanel/__tests__/ src/components/IALab/IALabQuizModal/__tests__/ src/components/DiagnosticoVAK/__tests__/ src/components/Nico/__tests__/ src/components/kids-dashboard/dani/__tests__/ src/components/__tests__/ src/services/__tests__/ src/utils/__tests__/ src/tests/a11y/ src/tests/integration/ src/components/IALab/PDFThumbnail.test.jsx",
    "check-budget": "node scripts/check-budget.mjs",
    "optimize-images": "node scripts/optimize-images.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts e2e/smartboard.spec.ts e2e/smartboard-authed.spec.ts --project=chromium",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src/components/IALab/ --ext .js,.jsx --max-warnings 1300",
    "lint:all": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .js,.jsx --max-warnings 6000",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.css": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.0.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@sentry/react": "^10.67.0",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-query": "^5.36.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "dompurify": "^3.4.7",
    "framer-motion": "^12.42.2",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.4",
    "pdfjs-dist": "^5.7.284",
    "posthog-js": "^1.404.1",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.14.0",
    "react-window": "^2.2.7",
    "recharts": "^3.8.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/react": "4.12.1",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react-vite": "^8.6.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.0",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "postcss": "^8.4.35",
    "prettier": "^3.8.4",
    "puppeteer-core": "^25.3.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "^8.6.18",
    "tailwindcss": "^3.4.1",
    "terser": "^5.49.0",
    "typescript": "^6.0.3",
    "vite": "5.4.21",
    "vite-plugin-prerender": "^1.0.8",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "rollup": "4.60.4",
    "vitest": {
      "vite": {
        "esbuild": "0.28.2"
      }
    }
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead",
    "iOS >= 12",
    "Safari >= 12",
    "Chrome >= 80",
    "Firefox >= 80",
    "not ie 11"
  ]
}