{
  "framework": "vite",
  "buildCommand": "npm run build:fast",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/Doc/(.*)",
      "destination": "/Doc/$1"
    },
    {
      "source": "/images/(.*)",
      "destination": "/images/$1"
    },
    {
      "source": "/ialab-resources/(.*)",
      "destination": "/ialab-resources/$1"
    },
    {
      "source": "/api/:path*",
      "destination": "https://edutechlife-backend.onrender.com/api/:path*"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/auth-router",
      "destination": "/index.html"
    },
    {
      "source": "/neuroentorno",
      "destination": "/index.html"
    },
    {
      "source": "/proyectos",
      "destination": "/index.html"
    },
    {
      "source": "/consultoria",
      "destination": "/index.html"
    },
    {
      "source": "/consultoria-b2b",
      "destination": "/index.html"
    },
    {
      "source": "/automation",
      "destination": "/index.html"
    },
    {
      "source": "/vak",
      "destination": "/index.html"
    },
    {
      "source": "/vak-simple",
      "destination": "/index.html"
    },
    {
      "source": "/vak-premium",
      "destination": "/index.html"
    },
    {
      "source": "/ialab-academic",
      "destination": "/index.html"
    },
    {
      "source": "/ialab-pro",
      "destination": "/index.html"
    },
    {
      "source": "/conoce-ingenia",
      "destination": "/index.html"
    },
    {
      "source": "/planes",
      "destination": "/index.html"
    },
    {
      "source": "/ingenia",
      "destination": "/index.html"
    },
    {
      "source": "/ingenia/consent",
      "destination": "/index.html"
    },
    {
      "source": "/ingenia/login",
      "destination": "/index.html"
    },
    {
      "source": "/ingenia/padres",
      "destination": "/index.html"
    },
    {
      "source": "/ingenia/estadisticas",
      "destination": "/index.html"
    },
    {
      "source": "/ialab",
      "destination": "/index.html"
    },
    {
      "source": "/ialab/:moduleId",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/login",
      "destination": "/index.html"
    },
    {
      "source": "/admin/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/sign-up",
      "destination": "/index.html"
    },
    {
      "source": "/sign-up/ialab",
      "destination": "/index.html"
    },
    {
      "source": "/sign-up/ingenia",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/index.html"
    },
    {
      "source": "/auth/reset-password",
      "destination": "/index.html"
    },
    {
      "source": "/profile/:userId",
      "destination": "/index.html"
    },
    {
      "source": "/verificar/:certNumber",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.youtube.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com 'sha256-03RckEsAJpkqnukJVsiOEjT0SfAcVFbLH7y55k9OCvM=' 'sha256-JxZdJVKHwrio0AEjInjtQkQxpanb1HauYKcwIdv76D4='; worker-src 'self' blob: https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; media-src 'self' data: blob: https://*.supabase.co; connect-src 'self' http://localhost:3001 ws://localhost:3001 https://edutechlife-backend.onrender.com https://*.supabase.co wss://*.supabase.co https://fonts.googleapis.com https://fonts.gstatic.com; font-src 'self' https://fonts.gstatic.com; frame-src 'self' https://www.youtube.com https://srirrwpgswlnuqfgtule.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/conoce-smartboard",
      "destination": "/conoce-ingenia",
      "permanent": false
    },
    {
      "source": "/smartboard",
      "destination": "/ingenia",
      "permanent": false
    },
    {
      "source": "/smartboard/consent",
      "destination": "/ingenia/consent",
      "permanent": false
    },
    {
      "source": "/smartboard/login",
      "destination": "/ingenia/login",
      "permanent": false
    },
    {
      "source": "/smartboard/padres",
      "destination": "/ingenia/padres",
      "permanent": false
    },
    {
      "source": "/smartboard/estadisticas",
      "destination": "/ingenia/estadisticas",
      "permanent": false
    },
    {
      "source": "/sign-up/smartboard",
      "destination": "/sign-up/ingenia",
      "permanent": false
    }
  ]
}
