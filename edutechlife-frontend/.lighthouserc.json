{
  "ci": {
    "collect": {
      "startServerCommand": "npx vite preview --port 4173",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/nosotros",
        "http://localhost:4173/contacto"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.5 }],
        "categories:accessibility": ["warn", { "minScore": 0.6 }],
        "categories:best-practices": ["warn", { "minScore": 0.6 }],
        "categories:seo": ["warn", { "minScore": 0.7 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci-reports"
    }
  }
}
