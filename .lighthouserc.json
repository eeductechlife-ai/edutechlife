{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "staticDistDir": "./edutechlife-frontend/dist",
      "url": [
        "http://localhost:5174/",
        "http://localhost:5174/ialab",
        "http://localhost:5174/smartboard",
        "http://localhost:5174/admin"
      ],
      "settings": {
        "chromeFlags": "--no-sandbox --headless --disable-gpu"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.90,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.90,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.90,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:pwa": [
          "warn",
          {
            "minScore": 0.90,
            "aggregationMethod": "median-run"
          }
        ],
        "modern-javascript-module": "off",
        "csp-xss-audit": "off"
      }
    }
  }
}
