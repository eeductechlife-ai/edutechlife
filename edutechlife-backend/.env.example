# DeepSeek API Configuration
# Get your API key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_api_key_here

# IALab Specific Configuration
IALAB_MAX_TOKENS=800
IALAB_TEMPERATURE=0.7
IALAB_TIMEOUT_MS=10000

# Server port (optional, defaults to 3001)
PORT=3001

# Google Cloud for TTS (optional)
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# Stripe Payments (optional — solo si se usa facturación)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRO_PRICE_ID=price_your_pro_price_id_here

# Frontend URL (para redirects de Stripe Checkout)
FRONTEND_URL=http://localhost:5174
