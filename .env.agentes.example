# Copia este archivo como .env.agentes (está en .gitignore) y llénalo.
# Solo cuentas y claves DE PRUEBA o DE SOLO LECTURA. Nunca cuentas de estudiantes reales.

# --- Cuentas de prueba en edutechlife.co (créalas tú; correos tipo agentes+ialab@edutechlife.co) ---
AGENTE_IALAB_EMAIL=
AGENTE_IALAB_PASSWORD=
AGENTE_INGENIA_NINO_EMAIL=
AGENTE_INGENIA_NINO_PASSWORD=
AGENTE_INGENIA_PADRE_EMAIL=
AGENTE_INGENIA_PADRE_PASSWORD=
AGENTE_DOCENTE_EMAIL=
AGENTE_DOCENTE_PASSWORD=

# --- Analítica (solo lectura) ---
POSTHOG_PERSONAL_API_KEY=      # PostHog > Settings > Personal API keys, alcance solo lectura
POSTHOG_PROJECT_ID=
STRIPE_RESTRICTED_KEY_READ=    # Stripe > Developers > API keys > Restricted key, todo en "Read"

# --- Operaciones (solo lectura) ---
SENTRY_AUTH_TOKEN_READ=        # Sentry > Settings > Auth Tokens, alcance solo lectura (project:read, event:read)
SENTRY_ORG=
SENTRY_PROJECT=
